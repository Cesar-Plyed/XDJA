{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@components/atoms": ["./src/components/atoms/index.ts"],
      "@components/atoms/*": ["./src/components/atoms/*"],
      "@components/molecules": ["./src/components/molecules/index.ts"],
      "@components/molecules/*": ["./src/components/molecules/*"],
      "@components/organisms": ["./src/components/organisms/index.ts"],
      "@components/organisms/*": ["./src/components/organisms/*"],
      "@components/templates": ["./src/components/templates/index.ts"],
      "@components/templates/*": ["./src/components/templates/*"],
      "@routes": ["./src/routes/index.ts"],
      "@routes/*": ["./src/routes/*"],
      "@hooks": ["./src/hooks/index.ts"],
      "@hooks/*": ["./src/hooks/*"],
      "@pages": ["./src/pages/index.ts"],
      "@pages/*": ["./src/pages/*"],
      "@styles": ["./src/styles/index.ts"],
      "@styles/*": ["./src/styles/*"],
      "@types_cm": ["./src/types/index.ts"],
      "@types_cm/*": ["./src/types/*"],
      "@i18n": ["./src/i18n/index.ts"],
      "@i18n/*": ["./src/i18n/*"],
      "@lib": ["./src/lib/index.ts"],
      "@lib/*": ["./src/lib/*"],
      "@assets/*": ["./src/assets/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}